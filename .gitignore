# --- Listes de mots : jamais versionnees -------------------------------------
# L'Officiel du Scrabble est une oeuvre editee par Larousse. Les depots qui la
# diffusent sont sous licence MIT, mais une licence MIT sur un depot ne donne
# aucun droit sur le contenu lui-meme. On ne redistribue donc pas la liste : elle
# est telechargee au premier lancement, sur la machine de l'utilisateur.
build/mots-source.txt
build/freq-raw.txt
build/*-raw.txt

# --- Dictionnaires compiles (derives des listes ci-dessus) --------------------
app/data/*.bin
app/data/dict-manifest.json

# --- Donnees personnelles et etat local --------------------------------------
# Parties en cours, records, sauvegardes, dictionnaire remplace.
data/

# --- Moteur portable ----------------------------------------------------------
# node.exe telecharge au premier lancement (~80 Mo). N'a rien a faire dans un
# depot : il se recupere tout seul, et sa version depend de la machine.
runtime/

# --- Raccourcis ecartes -------------------------------------------------------
# Raccourci depose par le navigateur a l'installation, range ici : il est propre
# a la machine et a son profil.
raccourcis-ecartes/

# --- Divers -------------------------------------------------------------------
node_modules/
*.log
Thumbs.db
desktop.ini
